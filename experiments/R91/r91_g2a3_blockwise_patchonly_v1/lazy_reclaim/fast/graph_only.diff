+  void reclaim_completed_prefix(size_t completed_vertices, size_t &reclaimed_bytes) {
+    constexpr size_t ALIGNMENT = 1L << 21;
+    if (completed_vertices > n || kMaxDegree == static_cast<size_t>(-1)) abort();
+    const size_t stride = kMaxDegree + 1;
+    if (stride > static_cast<size_t>(-1) / sizeof(T)) abort();
+    const size_t row_bytes = stride * sizeof(T);
+    if (completed_vertices > static_cast<size_t>(-1) / row_bytes) abort();
+    const size_t consumed = completed_vertices * row_bytes;
+    const size_t reclaim_end = (consumed / ALIGNMENT) * ALIGNMENT;
+    if (reclaim_end <= reclaimed_bytes) return;
+    if (reclaimed_bytes % ALIGNMENT != 0) abort();
+    // Both address and length are 2MiB aligned and behind the barrier.
+    if (madvise(reinterpret_cast<unsigned char*>(tables) + reclaimed_bytes,
+                reclaim_end - reclaimed_bytes, MADV_DONTNEED) != 0) abort();
